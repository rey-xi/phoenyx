{
  "name": "multi-provider-auth-showcase",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch server/dev.ts\" \"vite\"",
    "dev:server": "tsx watch server/dev.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/dev.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "telegram:webhook": "tsx server/scripts/register-telegram-webhook.ts",
    "telegram:webhook:delete": "tsx server/scripts/register-telegram-webhook.ts --delete"
  },
  "dependencies": {
    "@upstash/redis": "^1.39.0",
    "dotenv": "^18.0.8",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "grammy": "^1.46.0",
    "jose": "^6.2.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
